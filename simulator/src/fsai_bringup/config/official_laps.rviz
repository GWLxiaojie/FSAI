Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 65; 85; 65
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Official ADS-DV
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Official Sprint layout
      Enabled: true
      Topic:
        Value: /ground_truth/track_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Lap progress
      Enabled: true
      Topic:
        Value: /sim/reference/markers
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Odometry
      Name: Reference trace
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 10
      Keep: 150
      Position Tolerance: 0.5
      Angle Tolerance: 0.2
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_footprint
      Distance: 11
      Focal Point:
        X: 1
        Y: 0
        Z: 0.3
      Pitch: 0.65
      Yaw: 3.8
Window Geometry:
  Width: 1280
  Height: 800
