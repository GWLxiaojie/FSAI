<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsai_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the FSAI simulator.</description>

  <maintainer email="AlvinMuhanYu@outlook.com">Muhan Yu</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>eufs_sim2</exec_depend>
  <exec_depend>fsai_description</exec_depend>
  <exec_depend>fsai_sim2_adapter</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vehicle_models</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
